#!/bin/sh
# Wrapper of titan-team (crates/titan-team), the team tool in Rust that
# replaced the Python prototype in phase 3 (ADR-0005, ADR-0010). It builds
# on first use (only titan-team and the core, not the interface) and passes
# the arguments through: bin/team roles, bin/team ask <role> <task>...
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec cargo run --quiet --release --manifest-path "$root/Cargo.toml" -p titan-team -- "$@"
