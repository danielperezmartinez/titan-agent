#!/usr/bin/env python3
"""Gestión de encargos del equipo definido en .agents/team.toml.

Prototipo copiado de la sandbox multiagente (fase 0 de titan-agent). Lo sustituye
titan-team en Rust en la fase 3 (docs/Decisiones/ADR-0005).
"""
import argparse
import fnmatch
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import tomllib
except ImportError:  # Python 3.11 es el mínimo especificado
    tomllib = None


class TeamError(Exception):
    def __init__(self, message, code=2):
        super().__init__(message)
        self.code = code


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def git(repo, *args, check=True, capture=True, timeout=None):
    try:
        p = subprocess.run(["git", "-C", str(repo), *map(str, args)], text=True,
                           capture_output=capture, timeout=timeout)
    except FileNotFoundError:
        raise TeamError("git no está disponible en PATH")
    except subprocess.TimeoutExpired:
        raise TeamError("git agotó el tiempo de espera")
    if check and p.returncode:
        detail = (p.stderr or p.stdout or "").strip()
        raise TeamError(detail or f"git terminó con exit {p.returncode}")
    return p


def find_config(explicit=None):
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if path.is_dir():
            path /= ".agents/team.toml"
        if not path.is_file():
            raise TeamError(f"No existe la configuración: {path}")
        return path
    for parent in (Path.cwd(), *Path.cwd().parents):
        candidate = parent / ".agents/team.toml"
        if candidate.is_file():
            return candidate
    raise TeamError("No se encuentra .agents/team.toml; usa --config RUTA")


def load_config(path):
    if tomllib is None:
        raise TeamError("Se necesita Python 3.11 o posterior")
    try:
        with path.open("rb") as f:
            cfg = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise TeamError(f"No se pudo leer {path}: {e}")
    cfg["_config"] = path
    cfg["_base"] = path.parent.parent.resolve()
    cfg.setdefault("project", {})
    cfg.setdefault("flow", {})
    cfg.setdefault("roles", {})
    cfg["_state"] = (cfg["_base"] / cfg.get("state_dir", ".agents/state")).resolve()
    return cfg


def relpath(cfg, value):
    p = Path(value)
    return (p if p.is_absolute() else cfg["_base"] / p).resolve()


def require_role(cfg, name, launch=True):
    roles = cfg["roles"]
    if name not in roles:
        raise TeamError(f"Rol inexistente: {name}")
    role = roles[name]
    if role.get("cli") not in ("codex", "claude"):
        raise TeamError(f"Rol {name}: cli desconocido ({role.get('cli')})")
    if launch and role.get("launch", True) is False:
        raise TeamError(f"El rol {name} tiene launch=false y no se puede encargar")
    # La herramienta no lanza Claude Code (claude -p): ADR-0001 y ADR-0005.
    if launch and role.get("cli") != "codex":
        raise TeamError(f"El rol {name} usa cli={role.get('cli')}; bin/team solo lanza roles codex")
    return role


def path_matches(filename, pattern):
    """fnmatch pattern; a trailing "/" covers everything below that directory."""
    if pattern.endswith("/"):
        pattern += "*"
    return fnmatch.fnmatchcase(filename, pattern)


def path_warnings(role, changed):
    warnings = []
    allowed = role.get("allowed_paths") or []
    forbidden = role.get("forbidden_paths") or []
    for filename in changed:
        if allowed and not any(path_matches(filename, x) for x in allowed):
            warnings.append(f"Fichero fuera de allowed_paths: {filename}")
        if any(path_matches(filename, x) for x in forbidden):
            warnings.append(f"Fichero dentro de forbidden_paths: {filename}")
    return warnings


def task_name(name):
    if not re.fullmatch(r"[a-z0-9-]+", name):
        raise TeamError("El encargo debe cumplir [a-z0-9-]+", 2)


def task_paths(cfg, task):
    task_name(task)
    return cfg["_state"] / f"{task}.json", cfg["_state"] / task


def load_state(cfg, task):
    state_file, _ = task_paths(cfg, task)
    try:
        with state_file.open(encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        raise TeamError(f"No existe el encargo {task}")
    except (OSError, json.JSONDecodeError) as e:
        raise TeamError(f"No se pudo leer el estado de {task}: {e}")


def save_state(cfg, state):
    state_file, _ = task_paths(cfg, state["task"])
    state_file.parent.mkdir(parents=True, exist_ok=True)
    temp = state_file.with_name(state_file.name + f".{os.getpid()}.tmp")
    temp.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(temp, state_file)


def worktree(cfg, state):
    return relpath(cfg, state["worktree"])


def repo_path(cfg):
    return relpath(cfg, cfg["project"].get("repo", "."))


def output_name(n, role, suffix):
    safe = re.sub(r"[^a-zA-Z0-9_-]", "_", role)
    return f"{n:02d}-{safe}.{suffix}"


def run_tests(cfg, state):
    command = cfg["project"].get("test_cmd")
    if not command:
        raise TeamError("No hay project.test_cmd configurado")
    limit = cfg["project"].get("test_timeout_s", 300)
    try:
        p = subprocess.run(command, cwd=worktree(cfg, state), shell=True, text=True,
                           capture_output=True, timeout=limit)
        text = (p.stdout or "") + (p.stderr or "")
        return p.returncode, "\n".join(text.splitlines()[-150:])
    except subprocess.TimeoutExpired as e:
        raw = (e.stdout or b"") + (e.stderr or b"")
        if isinstance(raw, bytes):
            raw = raw.decode(errors="replace")
        return 124, "\n".join(raw.splitlines()[-150:]) + f"\nTests agotaron {limit} s"


def cmd_roles(cfg, args):
    if args.json:
        print(json.dumps({"roles": cfg["roles"], "flow": cfg["flow"]}, ensure_ascii=False, indent=2))
        return 0
    print("ROL\tCLI\tMODELO\tESFUERZO\tSANDBOX\tPROPÓSITO")
    for name, role in cfg["roles"].items():
        print("\t".join(str(x or "-") for x in (name, role.get("cli"), role.get("model"),
              role.get("effort", "-"), role.get("sandbox", "-"), role.get("purpose", ""))))
    flow = cfg["flow"]
    print("Flujo: " + " → ".join(flow.get("steps", [])))
    print(f"Revisor: {flow.get('review_role', '-')} · corrector: {flow.get('fix_role', '-')} · máximo rondas: {flow.get('max_review_rounds', '-')}")
    return 0


def cmd_new(cfg, args):
    task_name(args.task)
    state_file, task_dir = task_paths(cfg, args.task)
    if state_file.exists():
        raise TeamError(f"Ya existe el encargo {args.task}")
    repo = repo_path(cfg)
    if not repo.is_dir():
        raise TeamError(f"No existe el repositorio configurado: {repo}")
    brief_src = Path(args.brief).expanduser()
    if not brief_src.is_absolute():
        brief_src = (Path.cwd() / brief_src).resolve()
    if not brief_src.is_file():
        raise TeamError(f"No existe el brief: {brief_src}")
    base = args.base or cfg["project"].get("base", "main")
    commit = git(repo, "rev-parse", base).stdout.strip()
    wt = relpath(cfg, str(Path(cfg["project"].get("worktrees_dir", "worktrees")) / args.task))
    branch = cfg["project"].get("branch_prefix", "encargo/") + args.task
    wt.parent.mkdir(parents=True, exist_ok=True)
    git(repo, "worktree", "add", "-b", branch, wt, base)
    task_dir.mkdir(parents=True, exist_ok=True)
    brief_dest = task_dir / "encargo.md"
    shutil.copyfile(brief_src, brief_dest)
    state = {"task": args.task, "created": now(), "repo": os.path.relpath(repo, cfg["_base"]),
             "worktree": os.path.relpath(wt, cfg["_base"]), "branch": branch, "base": base,
             "base_commit": commit, "brief": os.path.relpath(brief_dest, cfg["_base"]),
             "review_rounds": 0, "roles": {}, "history": []}
    save_state(cfg, state)
    print(f"Worktree: {wt}\nRama: {branch}\nSiguiente paso: bin/team ask <rol> {args.task}  (primer rol de flow.steps)")
    return 0


def codex_cmd(role, thread_id, out_file, wt):
    cmd = ["codex", "exec"]
    if thread_id:
        cmd += ["resume", "--json", "-o", str(out_file), "-m", role["model"]]
    else:
        cmd += ["--json", "-o", str(out_file), "-m", role["model"]]
    if role.get("effort"):
        cmd += ["-c", f"model_reasoning_effort={role['effort']}"]
    if thread_id:
        cmd += ["-c", f"sandbox_mode=\"{role.get('sandbox', 'read-only')}\""]
    else:
        cmd += ["-s", role.get("sandbox", "read-only"), "-C", str(wt)]
    if role.get("output_schema"):
        cmd += ["--output-schema", str(role["_schema_path"])]
    if thread_id:
        cmd += [thread_id]
    cmd += ["-"]
    return cmd


def parse_codex(stdout, out_file):
    thread = None
    usage = {"input_tokens": 0, "cached_input_tokens": 0, "output_tokens": 0}
    errors, last_text = [], ""
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if thread is None and event.get("thread_id"):
            thread = event["thread_id"]
        if event.get("type") == "turn.completed":
            values = event.get("usage", {})
            for key in usage:
                usage[key] += values.get(key, 0) or 0
        if event.get("type") == "turn.failed":
            errors.append(event.get("error", {}).get("message", "turn.failed"))
        if event.get("type") == "error":
            errors.append(event.get("message", "error"))
        item = event.get("item", {})
        if event.get("type") == "item.completed" and item.get("type") == "agent_message":
            last_text = item.get("text", last_text)
    if out_file.is_file():
        text = out_file.read_text(encoding="utf-8", errors="replace")
    else:
        text = last_text
    return {"thread_id": thread, "text": text, "usage": usage, "error": "; ".join(errors)}


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def cmd_ask(cfg, args):
    role = require_role(cfg, args.role)
    state = load_state(cfg, args.task)
    wt = worktree(cfg, state)
    if not wt.is_dir():
        raise TeamError(f"No existe el worktree: {wt}")
    info = state.setdefault("roles", {}).get(args.role, {})
    thread_id = info.get("thread_id") if not args.new else None
    if thread_id and not (args.message or args.file):
        raise TeamError("Para continuar un hilo es obligatorio indicar -m o -f")
    message = args.message
    if args.file:
        try:
            message = Path(args.file).read_text(encoding="utf-8")
        except OSError as e:
            raise TeamError(f"No se pudo leer el mensaje: {e}")
    task_dir = task_paths(cfg, args.task)[1]
    if thread_id:
        prompt = "# Mensaje del director\n\n" + (message or "")
    else:
        prompt_file = relpath(cfg, role.get("prompt_file", ""))
        brief_file = relpath(cfg, state["brief"])
        try:
            prompt = prompt_file.read_text(encoding="utf-8") + "\n\n# Encargo\n\n" + brief_file.read_text(encoding="utf-8")
        except OSError as e:
            raise TeamError(f"No se pudo leer el prompt o encargo: {e}")
        if message:
            prompt += "\n\n# Mensaje del director\n\n" + message
    warnings = []
    if args.diff:
        diff = git(wt, "diff", f"{state['base_commit']}..HEAD").stdout
        if len(diff) > 60000:
            diff = diff[:60000]
            warnings.append("Diff truncado a 60 000 caracteres")
        prompt += "\n\n# Diff respecto a la base\n\n" + diff
    if args.test:
        code, test_output = run_tests(cfg, state)
        prompt += f"\n\n# Resultado de los tests (exit {code})\n\n{test_output}"
    is_reviewer = args.role == cfg["flow"].get("review_role")
    next_round = state.get("review_rounds", 0) + (1 if is_reviewer else 0)
    maximum = cfg["flow"].get("max_review_rounds", 0)
    if is_reviewer and next_round > maximum and not args.force:
        raise TeamError(f"Se superó el máximo de rondas de revisión ({maximum}); usa --force", 3)
    entry_n = len(state.get("history", [])) + 1
    raw_file = task_dir / output_name(entry_n, args.role, "jsonl")
    agent_output = task_dir / output_name(entry_n, args.role, "response")
    if role.get("output_schema"):
        role["_schema_path"] = relpath(cfg, role["output_schema"])
    command = codex_cmd(role, thread_id, agent_output, wt)
    if args.dry_run:
        print("Comando: " + shlex.join(command))
        print("\n--- prompt ---\n" + prompt)
        return 0
    if shutil.which(role["cli"]) is None:
        raise TeamError(f"{role['cli']} no está disponible en PATH")
    task_dir.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    status, rawout, rawerr = "ok", "", ""
    try:
        p = subprocess.run(command, input=prompt, capture_output=True, text=True,
                           timeout=role.get("timeout_s", 900), cwd=wt)
        rawout, rawerr = p.stdout, p.stderr
        if p.returncode:
            status = "error"
    except subprocess.TimeoutExpired as e:
        status = "timeout"
        rawout = e.stdout or ""
        rawerr = e.stderr or ""
        if isinstance(rawout, bytes): rawout = rawout.decode(errors="replace")
        if isinstance(rawerr, bytes): rawerr = rawerr.decode(errors="replace")
    raw_file.write_text(rawout, encoding="utf-8")
    (task_dir / output_name(entry_n, args.role, "stderr")).write_text(rawerr, encoding="utf-8")
    parsed = parse_codex(rawout, agent_output)
    try:
        agent_output.unlink()
    except FileNotFoundError:
        pass
    if parsed.get("error"):
        status = "error"
    text = parsed.get("text", "")
    parsed_review = None
    if role.get("output_schema"):
        parsed_review = read_json(Path(text)) if text and Path(text).is_file() else None
        if parsed_review is None:
            try: parsed_review = json.loads(text)
            except (ValueError, TypeError): pass
        suffix = "json"
        output_text = text
    else:
        suffix, output_text = "md", text
    output_rel = os.path.relpath(task_dir / output_name(entry_n, args.role, suffix), cfg["_base"])
    (task_dir / output_name(entry_n, args.role, suffix)).write_text(output_text, encoding="utf-8")
    commit = None
    changed = []
    if role.get("sandbox") != "read-only" and cfg["project"].get("autocommit", False):
        git(wt, "add", "-A")
        staged = git(wt, "diff", "--cached", "--quiet", check=False)
        if staged.returncode:
            identity = git(wt, "config", "user.name", check=False).returncode == 0 and git(wt, "config", "user.email", check=False).returncode == 0
            prefix = [] if identity else ["-c", "user.name=team", "-c", "user.email=team@localhost"]
            git(wt, *prefix, "commit", "-m", f"team: {args.role} turno {info.get('turns', 0)+1}")
            commit = git(wt, "rev-parse", "--short", "HEAD").stdout.strip()
            changed = git(wt, "diff", "--name-only", "HEAD~1..HEAD").stdout.splitlines()
    elif role.get("sandbox") == "read-only" and git(wt, "status", "--porcelain").stdout.strip():
        warnings.append("El rol read-only dejó cambios en el árbol")
    warnings += path_warnings(role, changed)
    turn = info.get("turns", 0) + 1
    entry = {"n": entry_n, "ts": now(), "role": args.role, "turn": turn,
             "thread_id": parsed.get("thread_id") or thread_id, "resumed": bool(thread_id),
             "status": status, "duration_s": round(time.monotonic()-started, 1),
             "usage": parsed.get("usage", {}), "output": output_rel, "commit": commit,
             "changed_files": changed, "warnings": warnings}
    state["history"].append(entry)
    state["roles"][args.role] = {"cli": role["cli"], "model": role["model"],
                                  "thread_id": entry["thread_id"], "turns": turn}
    if is_reviewer:
        state["review_rounds"] = next_round
        cfg["_last_review_round"] = next_round
    save_state(cfg, state)
    if args.json:
        print(json.dumps({**entry, "text": text, "parsed": parsed_review}, ensure_ascii=False))
    else:
        print_report(cfg, args.role, role, entry, text, parsed_review)
    return 0 if status == "ok" else 1


def print_report(cfg, role_name, role, entry, text, review):
    usage = entry.get("usage", {})
    line = f"## {role_name} · turno {entry['turn']} ({'continúa' if entry['resumed'] else 'nuevo'}) · {role['cli']} {role['model']}/{role.get('effort', '-')}"
    print(line)
    print(f"estado: {entry['status']} · {entry['duration_s']} s · tokens: {usage.get('input_tokens', 0):,} entrada ({usage.get('cached_input_tokens', 0):,} en caché) · {usage.get('output_tokens', 0):,} salida")
    if entry.get("commit"):
        print(f"commit: {entry['commit']} · {len(entry['changed_files'])} ficheros: {', '.join(entry['changed_files'])}")
    print("avisos: " + ("; ".join(entry["warnings"]) or "ninguno"))
    print("salida: " + entry["output"])
    if role_name == cfg["flow"].get("review_role"):
        print(f"ronda de revisión: {cfg.get('_last_review_round', entry['n'])}/{cfg['flow'].get('max_review_rounds', '?')}")
    if isinstance(review, dict) and "verdict" in review:
        print("veredicto: " + str(review.get("verdict")))
        for key, label in (("summary", "resumen"), ("tests_assessment", "tests")):
            if review.get(key): print(f"{label}: {review[key]}")
        for finding in review.get("findings", []):
            if isinstance(finding, dict):
                print(f"- [{finding.get('severity', '?')}] {finding.get('file', '?')}:{finding.get('line', '?')} — {finding.get('issue', '')} → {finding.get('suggestion', '')}")
        for question in review.get("questions_for_director", []): print("- Pregunta: " + str(question))
    else:
        print("\n" + text)


def cmd_show(cfg, args):
    state = load_state(cfg, args.task)
    if args.json:
        print(json.dumps(state, ensure_ascii=False, indent=2)); return 0
    maximum = cfg["flow"].get("max_review_rounds", "?")
    print(f"Encargo: {state['task']}\nWorktree: {state['worktree']}\nRama: {state['branch']}\nRevisiones: {state.get('review_rounds', 0)}/{maximum}")
    for name, info in state.get("roles", {}).items():
        print(f"Rol {name}: hilo {info.get('thread_id') or '-'} · turnos {info.get('turns', 0)}")
    for h in state.get("history", []):
        usage = h.get("usage", {})
        print(f"{h['n']:02d} {h['role']} turno {h['turn']} {h['status']} {h.get('duration_s', 0)}s tokens {usage.get('input_tokens', 0)}/{usage.get('output_tokens', 0)} commit {h.get('commit') or '-'} avisos {', '.join(h.get('warnings', [])) or '-'} salida {h.get('output', '-')}")
    return 0


def cmd_diff(cfg, args):
    state = load_state(cfg, args.task)
    extra = ["--stat"] if args.stat else []
    p = git(worktree(cfg, state), "diff", *extra, f"{state['base_commit']}..HEAD", check=False)
    sys.stdout.write(p.stdout); sys.stderr.write(p.stderr)
    return p.returncode


def cmd_test(cfg, args):
    state = load_state(cfg, args.task)
    code, output = run_tests(cfg, state)
    print(f"exit: {code}")
    print(output)
    return code


def cmd_close(cfg, args):
    state = load_state(cfg, args.task)
    wt = worktree(cfg, state)
    git(repo_path(cfg), "worktree", "remove", wt)
    if args.delete_branch:
        git(repo_path(cfg), "branch", "-D", state["branch"])
    state["closed"] = True
    state["closed_at"] = now()
    save_state(cfg, state)
    print(f"Encargo {args.task} cerrado")
    return 0


def parser():
    p = argparse.ArgumentParser(prog="team", description="Gestiona encargos del equipo")
    p.add_argument("--config", help="Ruta a team.toml")
    sub = p.add_subparsers(dest="command", required=True)
    roles = sub.add_parser("roles"); roles.add_argument("--json", action="store_true")
    new = sub.add_parser("new"); new.add_argument("task"); new.add_argument("--brief", required=True)
    new.add_argument("--base", help="Rama de la que sale el encargo (por defecto, project.base)")
    ask = sub.add_parser("ask"); ask.add_argument("role"); ask.add_argument("task")
    group = ask.add_mutually_exclusive_group(); group.add_argument("-m", "--message"); group.add_argument("-f", "--file")
    for flag in ("diff", "test", "new", "force", "dry-run", "json"): ask.add_argument("--"+flag, action="store_true")
    show = sub.add_parser("show"); show.add_argument("task"); show.add_argument("--json", action="store_true")
    diff = sub.add_parser("diff"); diff.add_argument("task"); diff.add_argument("--stat", action="store_true")
    test = sub.add_parser("test"); test.add_argument("task")
    close = sub.add_parser("close"); close.add_argument("task"); close.add_argument("--delete-branch", action="store_true")
    return p


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        cfg = load_config(find_config(args.config))
        commands = {"roles": cmd_roles, "new": cmd_new, "ask": cmd_ask,
                    "show": cmd_show, "diff": cmd_diff, "test": cmd_test, "close": cmd_close}
        return commands[args.command](cfg, args)
    except TeamError as e:
        print(str(e), file=sys.stderr)
        return e.code


if __name__ == "__main__":
    raise SystemExit(main())
