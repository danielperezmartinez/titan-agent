#!/bin/sh
# Fake `claude` CLI of the demo kit (scripts/demo/demo.sh): lists the
# invented sessions of agents.json and fakes `claude attach` in the
# terminal. A launch from the draft (`claude --bg …`) adds an invented
# session to agents.json (lanzar.py). It never starts Claude Code.
case "$1" in
  --bg) exec python3 -I "$(dirname -- "$0")/../lanzar.py" "$TITAN_DEMO_DIR/agents.json" "$PWD" "$@" ;;
  agents) cat "$TITAN_DEMO_DIR/agents.json" ;;
  attach)
    printf '\033[1m✻ Claude Code\033[0m (demo) · sesión %s\r\n\r\n' "$2"
    printf '● Encargo de titan-team: sftp-renombrar. Sol escribió 6 tests de\r\n'
    printf '  aceptación; Luna renombró los helpers y la compuerta pasó.\r\n\r\n'
    printf '● Bash(bin/team ask revisor sftp-renombrar --gate)\r\n'
    printf '  ⎿  Ejecutándose en segundo plano…\r\n\r\n'
    printf '> '
    while IFS= read -r _; do :; done
    ;;
  *) echo "claude (demo): orden no simulada: $*" >&2; exit 2 ;;
esac
