{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "tests_assessment", "findings", "questions_for_director"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["ok", "changes_requested", "blocked"],
      "description": "ok = se puede aceptar; changes_requested = hay correcciones concretas; blocked = el encargo es ambiguo o contradictorio y decide el director."
    },
    "summary": { "type": "string", "description": "Dos o tres frases para el director." },
    "tests_assessment": { "type": "string", "description": "¿Los tests cubren el encargo? ¿Pasan? Huecos." },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "issue", "suggestion"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor", "nit"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "issue": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    },
    "questions_for_director": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Decisiones de diseño que no le corresponden al revisor."
    }
  }
}
